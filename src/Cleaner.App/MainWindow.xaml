<ui:FluentWindow x:Class="Cleaner.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:pages="clr-namespace:Cleaner.App.Views.Pages"
                 xmlns:l="clr-namespace:Cleaner.App.Localization"
                 xmlns:controls="clr-namespace:Cleaner.App.Controls"
                 Title="QuietCare"
                 Width="1180" Height="790"
                 MinWidth="980" MinHeight="640"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                 TextOptions.TextFormattingMode="Display"
                 Icon="pack://application:,,,/Assets/QuietCare.ico"
                 mc:Ignorable="d">
    <Grid Background="{DynamicResource ApplicationBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Title="QuietCare"
                     Grid.Row="0"
                     ShowMaximize="True"
                     ShowMinimize="True">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/QuietCare.ico" />
            </ui:TitleBar.Icon>
            <ui:TitleBar.Header>
              <StackPanel x:Name="SmartCareActions" Orientation="Horizontal">
                <ui:Button x:Name="ShowMiniMonitor" Content="Mini monitor" Padding="12,4" Margin="0,0,8,0"
                           WindowChrome.IsHitTestVisibleInChrome="True" ToolTip="Show the tiny transparent CPU, GPU and RAM monitor" Click="MiniMonitor_Click"/>
                <ui:Button Content="Smart Care" Icon="{ui:SymbolIcon Flash24}" Appearance="Primary"
                           Padding="12,4" Margin="0,0,8,0" WindowChrome.IsHitTestVisibleInChrome="True"
                           ToolTip="One-click automatic care, available from every tool. Click again to view live steps." Click="SmartCare_Click"/>
                <ui:Button Content="Stop" Command="{Binding StopSmartCareCommand}" Margin="0,0,8,0" Padding="10,4"
                           Visibility="{Binding SmartCareRunning,Converter={StaticResource BoolToVis}}" WindowChrome.IsHitTestVisibleInChrome="True"/>
                <ui:Button Appearance="Transparent"
                           Icon="{ui:SymbolIcon Info24}"
                           ToolTip="{l:T Nav.About}"
                           Padding="8,4"
                           Margin="0,0,4,0"
                           WindowChrome.IsHitTestVisibleInChrome="True"
                           Click="InfoButton_Click" />
              </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <ui:NavigationView x:Name="RootNavigation"
                           Grid.Row="1"
                           PaneDisplayMode="Left"
                           IsBackButtonVisible="Collapsed"
                           OpenPaneLength="178" TransitionDuration="0">
            <ui:NavigationView.MenuItems>
                <ui:NavigationViewItem Content="Overview" TargetPageType="{x:Type pages:DashboardPage}" Icon="{ui:SymbolIcon Home24}"/>
                <ui:NavigationViewItem Content="Focus mode" TargetPageType="{x:Type pages:FocusPage}" Icon="{ui:SymbolIcon WeatherMoon24}"/>
                <ui:NavigationViewItem Content="Memory" TargetPageType="{x:Type pages:MemoryPage}" Icon="{ui:SymbolIcon Flash24}"/>
                <ui:NavigationViewItem Content="Protection" TargetPageType="{x:Type pages:ProtectionPage}" Icon="{ui:SymbolIcon Shield24}"/>
                <ui:NavigationViewItem Content="Storage" TargetPageType="{x:Type pages:StoragePage}" Icon="{ui:SymbolIcon Storage24}"/>
                <ui:NavigationViewItem Content="Startup" TargetPageType="{x:Type pages:AutostartPage}" Icon="{ui:SymbolIcon Rocket24}"/>
                <ui:NavigationViewItem Content="Toolbox" TargetPageType="{x:Type pages:ToolboxPage}" Icon="{ui:SymbolIcon Grid24}"/>
                <ui:NavigationViewItemSeparator/>
                <ui:NavigationViewItem Content="Recovery" TargetPageType="{x:Type pages:CleanupHistoryPage}" Icon="{ui:SymbolIcon History24}"/>
            </ui:NavigationView.MenuItems>

            <ui:NavigationView.FooterMenuItems>
                <ui:NavigationViewItem Content="{l:T Nav.About}" TargetPageType="{x:Type pages:AboutPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Info24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
                <ui:NavigationViewItem Content="{l:T Nav.Settings}" TargetPageType="{x:Type pages:SettingsPage}">
                    <ui:NavigationViewItem.Icon>
                        <ui:SymbolIcon Symbol="Settings24" />
                    </ui:NavigationViewItem.Icon>
                </ui:NavigationViewItem>
            </ui:NavigationView.FooterMenuItems>
        </ui:NavigationView>

        <!-- Background-Task-Status-Strip -->
        <Border Grid.Row="2"
                Background="{DynamicResource SolidBackgroundFillColorSecondaryBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0"
                Padding="20,6"
                Visibility="{Binding ElementName=TasksHost, Path=DataContext.Count, Converter={StaticResource BoolToVisFromInt}}">
            <Button x:Name="TasksTriggerButton"
                    Background="Transparent" BorderThickness="0"
                    Cursor="Hand" HorizontalContentAlignment="Left"
                    HorizontalAlignment="Stretch"
                    Click="TasksTriggerButton_Click">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="●" Foreground="{DynamicResource CareAccentBrush}" Margin="0,0,10,0"/>
                    <TextBlock VerticalAlignment="Center" FontSize="12">
                        <Run Text="{Binding ElementName=TasksHost, Path=DataContext.Count, Mode=OneWay}" />
                        <Run Text=" active task(s) — click for details" />
                    </TextBlock>
                </StackPanel>
            </Button>
        </Border>

        <!-- Hidden host to expose TaskRegistry to the popup -->
        <ContentControl x:Name="TasksHost" Visibility="Collapsed" />

        <Popup x:Name="TasksPopup"
               PlacementTarget="{Binding ElementName=TasksTriggerButton}"
               Placement="Top"
               StaysOpen="False"
               AllowsTransparency="True"
               PopupAnimation="Fade">
            <Border Margin="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.3" />
                </Border.Effect>
                <controls:RunningTasksPanel DataContext="{Binding ElementName=TasksHost, Path=DataContext}" />
            </Border>
        </Popup>
    </Grid>
</ui:FluentWindow>
