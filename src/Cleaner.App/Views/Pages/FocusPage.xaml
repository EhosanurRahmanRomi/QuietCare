<UserControl x:Class="Cleaner.App.Views.Pages.FocusPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <ScrollViewer Padding="30,24,30,24" VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="Focus mode" Style="{StaticResource CareSectionTitle}"/>
  <TextBlock Text="Less interruption. More room for what matters." Style="{StaticResource PageSubtitle}"/>
  <Border CornerRadius="18" Padding="26" Margin="0,0,0,20" BorderBrush="{DynamicResource CareAccentBrush}" BorderThickness="1">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#192638" Offset="0"/><GradientStop Color="#203A46" Offset="1"/></LinearGradientBrush></Border.Background>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel Margin="0,0,20,0"><TextBlock Text="A QUIETER WORKSPACE" Foreground="#76E2CE" FontSize="11" FontWeight="Bold"/><TextBlock Text="{Binding ViewModel.Headline}" Foreground="White" FontSize="26" FontWeight="SemiBold" Margin="0,8,0,8" TextWrapping="Wrap"/><TextBlock Text="{Binding ViewModel.Countdown}" Foreground="#C2D4E5" FontSize="14"/><TextBlock Text="{Binding ViewModel.WorkApp}" Foreground="#A9D6EC" FontSize="13" Margin="0,12,0,0" TextWrapping="Wrap"/></StackPanel>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><ui:Button Content="Start Focus" Icon="{ui:SymbolIcon Play24}" Appearance="Primary" FontSize="17" Padding="22,13" Command="{Binding ViewModel.StartCommand}" IsEnabled="{Binding ViewModel.CanStart}"/><ui:Button Content="End session" Padding="18,9" Margin="0,10,0,0" Command="{Binding ViewModel.StopCommand}" IsEnabled="{Binding ViewModel.IsActive}"/></StackPanel>
   </Grid>
  </Border>
  <Border Style="{StaticResource CarePanel}" Margin="0,0,0,20"><StackPanel>
   <Grid IsEnabled="{Binding ViewModel.CanConfigure}"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your session" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="Choose once, then start with one click. Maximum 4 hours." Style="{StaticResource CareCaption}" Margin="0,6,12,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Minutes" VerticalAlignment="Center" Margin="0,0,12,0"/><ui:NumberBox Width="100" Minimum="1" Maximum="240" Value="{Binding ViewModel.Minutes,Mode=TwoWay}"/></StackPanel></Grid>
   <WrapPanel Margin="0,18,0,0" IsEnabled="{Binding ViewModel.CanConfigure}"><CheckBox Content="Prioritize my active app" IsChecked="{Binding ViewModel.PrioritizeWork}" Margin="0,0,24,12"/><CheckBox Content="Lower background app priority" IsChecked="{Binding ViewModel.LowerBackground}" Margin="0,0,24,12"/><CheckBox Content="Do not disturb" IsChecked="{Binding ViewModel.QuietNotifications}" Margin="0,0,24,12"/><CheckBox Content="Keep PC awake" IsChecked="{Binding ViewModel.KeepAwake}" Margin="0,0,24,12"/><CheckBox Content="Temporary update guard (admin)" IsChecked="{Binding ViewModel.GuardUpdates}" Margin="0,0,0,12"/></WrapPanel>
  </StackPanel></Border>
  <Border Style="{StaticResource CarePanel}" Margin="0,0,0,20"><StackPanel><TextBlock Text="What Focus is doing" FontSize="17" FontWeight="SemiBold"/>
   <TextBlock Text="{Binding ViewModel.PriorityStatus}" Style="{StaticResource CareCaption}" Margin="0,14,0,0"/><TextBlock Text="{Binding ViewModel.NotificationStatus}" Style="{StaticResource CareCaption}" Margin="0,10,0,0"/><TextBlock Text="{Binding ViewModel.AwakeStatus}" Style="{StaticResource CareCaption}" Margin="0,10,0,0"/><TextBlock Text="{Binding ViewModel.UpdateStatus}" Style="{StaticResource CareCaption}" Margin="0,10,0,0"/>
   <Separator Margin="0,16,0,14"/><TextBlock Text="{Binding ViewModel.Detail}" Style="{StaticResource CareCaption}"/>
   <WrapPanel Margin="0,16,0,0"><ui:Button Content="Restore changes" Command="{Binding ViewModel.RestoreCommand}" IsEnabled="{Binding ViewModel.NeedsRecovery}" Margin="0,0,12,8"/><ui:Button Content="Windows notification settings" Command="{Binding ViewModel.OpenWindowsNotificationsCommand}" Margin="0,0,0,8"/></WrapPanel>
  </StackPanel></Border>
  <TextBlock Text="QuietCare defers its own care jobs and startup notification balloons during Focus; the mini monitor stays available. Windows, drivers, antivirus and app-internal popups can still use resources. The update guard requests temporary local policies on unmanaged Windows Pro, Enterprise or Education; updates already running and enforced deadlines can still continue. Open tabs, projects and apps are never closed or suspended." Style="{StaticResource CareCaption}"/>
 </StackPanel></ScrollViewer>
</UserControl>
