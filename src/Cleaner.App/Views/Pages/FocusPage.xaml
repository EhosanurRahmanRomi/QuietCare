<UserControl x:Class="Cleaner.App.Views.Pages.FocusPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <ScrollViewer Padding="26,20" VerticalScrollBarVisibility="Auto"><StackPanel>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Focus mode" Style="{StaticResource CareSectionTitle}"/><TextBlock Text="Prioritize work. Reduce background interruptions." Style="{StaticResource CareCaption}"/></StackPanel><Border Grid.Column="1" Background="{DynamicResource CareAccentSurface}" CornerRadius="12" Padding="12,6" VerticalAlignment="Center"><TextBlock Text="{Binding ViewModel.SessionLabel}" Style="{StaticResource CareEyebrow}"/></Border></Grid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="256"/></Grid.ColumnDefinitions>
   <StackPanel>
    <Border Style="{StaticResource CarePanel}" Padding="18,4,18,8"><StackPanel><TextBlock Text="SESSION CONTROLS" Style="{StaticResource CareEyebrow}" Margin="0,14,0,4"/>

     <Border Style="{StaticResource CareRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Rocket24" FontSize="19" Foreground="{DynamicResource CareMemoryAccent}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="Prioritize my work" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Follows your active app." Style="{StaticResource CareCaption}" FontSize="11" Margin="0,3,0,0"/></StackPanel><CheckBox Grid.Column="2" Style="{StaticResource CareSwitch}" AutomationProperties.Name="Prioritize my work" IsChecked="{Binding ViewModel.PrioritizeWork}" IsEnabled="{Binding ViewModel.CanConfigure}" VerticalAlignment="Center"/></Grid></Border>

     <Border Style="{StaticResource CareRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Apps24" FontSize="19" Foreground="{DynamicResource CareSecurityAccent}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="Reduce background contention" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Lowers eligible app priorities." Style="{StaticResource CareCaption}" FontSize="11" Margin="0,3,0,0"/></StackPanel><CheckBox Grid.Column="2" Style="{StaticResource CareSwitch}" AutomationProperties.Name="Reduce background contention" IsChecked="{Binding ViewModel.LowerBackground}" IsEnabled="{Binding ViewModel.CanConfigure}" VerticalAlignment="Center"/></Grid></Border>

     <Border Style="{StaticResource CareRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="AlertOff24" FontSize="19" Foreground="{DynamicResource CareCleanupAccent}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="Quiet notifications" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Windows Do not disturb." Style="{StaticResource CareCaption}" FontSize="11" Margin="0,3,0,0"/></StackPanel><CheckBox Grid.Column="2" Style="{StaticResource CareSwitch}" AutomationProperties.Name="Quiet notifications" IsChecked="{Binding ViewModel.QuietNotifications}" IsEnabled="{Binding ViewModel.CanConfigure}" VerticalAlignment="Center"/></Grid></Border>

     <Border Style="{StaticResource CareRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="WeatherSunny24" FontSize="19" Foreground="{DynamicResource CareDriveAccent}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="Keep the PC awake" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Only for this focus session." Style="{StaticResource CareCaption}" FontSize="11" Margin="0,3,0,0"/></StackPanel><CheckBox Grid.Column="2" Style="{StaticResource CareSwitch}" AutomationProperties.Name="Keep the PC awake" IsChecked="{Binding ViewModel.KeepAwake}" IsEnabled="{Binding ViewModel.CanConfigure}" VerticalAlignment="Center"/></Grid></Border>

     <Border Style="{StaticResource CareRow}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="34"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Shield24" FontSize="19" Foreground="{DynamicResource CareSecurityAccent}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Margin="0,0,14,0"><TextBlock Text="Guard against update interruptions" FontSize="13" FontWeight="SemiBold"/><TextBlock Text="Temporary policy · Windows approval." Style="{StaticResource CareCaption}" FontSize="11" Margin="0,3,0,0"/></StackPanel><CheckBox Grid.Column="2" Style="{StaticResource CareSwitch}" AutomationProperties.Name="Guard against update interruptions" IsChecked="{Binding ViewModel.GuardUpdates}" IsEnabled="{Binding ViewModel.CanConfigure}" VerticalAlignment="Center"/></Grid></Border>

    </StackPanel></Border>
    <Expander Header="Session details and recovery" Margin="0,14,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding ViewModel.Detail}" Style="{StaticResource CareCaption}"/><TextBlock Text="{Binding ViewModel.PriorityStatus}" Style="{StaticResource CareCaption}" Margin="0,8,0,0"/><TextBlock Text="{Binding ViewModel.NotificationStatus}" Style="{StaticResource CareCaption}" Margin="0,8,0,0"/><TextBlock Text="{Binding ViewModel.AwakeStatus}" Style="{StaticResource CareCaption}" Margin="0,8,0,0"/><TextBlock Text="{Binding ViewModel.UpdateStatus}" Style="{StaticResource CareCaption}" Margin="0,8,0,12"/><WrapPanel><ui:Button Content="Restore changes" Command="{Binding ViewModel.RestoreCommand}" IsEnabled="{Binding ViewModel.NeedsRecovery}" Margin="0,0,8,8"/><ui:Button Content="Notification settings" Command="{Binding ViewModel.OpenWindowsNotificationsCommand}" Margin="0,0,0,8"/></WrapPanel></StackPanel></Expander>
   </StackPanel>
   <StackPanel Grid.Column="2">
    <Border Style="{StaticResource CarePanel}" Background="{DynamicResource CareAccentSurface}" BorderBrush="{DynamicResource CareMemoryStroke}" Padding="20"><StackPanel>
     <ui:SymbolIcon Symbol="WeatherMoon24" FontSize="28" Foreground="{DynamicResource CareAccentBrush}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
     <TextBlock Text="Your focus session" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding ViewModel.Countdown}" FontSize="15" Margin="0,12,0,8" Foreground="{DynamicResource CareAccentBrush}"/>
     <ProgressBar Value="{Binding ViewModel.SessionProgress,Mode=OneWay}" Maximum="100" Height="3" Margin="0,0,0,14"/>
     <TextBlock Text="SESSION LENGTH" Style="{StaticResource CareEyebrow}"/><Grid Margin="0,10,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><ui:NumberBox Value="{Binding ViewModel.Minutes,Mode=TwoWay}" Minimum="1" Maximum="240" IsEnabled="{Binding ViewModel.CanConfigure}"/><TextBlock Grid.Column="1" Text="min" VerticalAlignment="Center" Margin="10,0,0,0" Style="{StaticResource CareCaption}"/></Grid>
     <ui:Button Content="Start focus session" Icon="{ui:SymbolIcon Play24}" Command="{Binding ViewModel.StartCommand}" IsEnabled="{Binding ViewModel.CanStart}" HorizontalAlignment="Stretch"><ui:Button.Style><Style TargetType="ui:Button" BasedOn="{StaticResource CareAction}"><Style.Triggers><DataTrigger Binding="{Binding ViewModel.IsActive}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></ui:Button.Style></ui:Button>
     <ui:Button Content="End focus session" Command="{Binding ViewModel.StopCommand}" Appearance="Primary" HorizontalAlignment="Stretch" Padding="12,10" Visibility="{Binding ViewModel.IsActive,Converter={StaticResource BoolToVis}}"/>
    </StackPanel></Border>
    <Border Style="{StaticResource CarePanel}" Margin="0,12,0,0"><StackPanel><TextBlock Text="WORK APP" Style="{StaticResource CareEyebrow}"/><TextBlock Text="{Binding ViewModel.WorkApp}" FontSize="14" FontWeight="SemiBold" Margin="0,9,0,5" TextWrapping="Wrap"/><TextBlock Text="Switch apps normally. Focus follows you." Style="{StaticResource CareCaption}" FontSize="11"/></StackPanel></Border>
   </StackPanel>
  </Grid>
  <TextBlock Text="Your mini monitor stays on. Open tabs and projects stay open. Windows and essential services can still use resources; owned changes restore when the session ends." Style="{StaticResource CareCaption}" FontSize="11" Margin="0,18,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>