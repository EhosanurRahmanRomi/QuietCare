<UserControl x:Class="Cleaner.App.Views.Pages.StoragePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}"><ScrollViewer Padding="26,20" VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Storage" Style="{StaticResource CareSectionTitle}"/><TextBlock Text="Clear the disposable. Keep the important." Style="{StaticResource PageSubtitle}"/>
<Border Style="{StaticResource CarePanel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding ViewModel.DiskDetail}" Style="{StaticResource CareEyebrow}"/><TextBlock Text="{Binding ViewModel.DiskAvailable}" FontSize="25" FontWeight="SemiBold" Margin="0,7,0,0"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><ProgressBar Value="{Binding ViewModel.DiskUsed}" Height="5" Maximum="100"/><ui:Button Content="Refresh drive" Command="{Binding ViewModel.RefreshStorageCommand}" Appearance="Transparent" HorizontalAlignment="Right" Padding="0,5" Margin="0,8,0,0"/></StackPanel></Grid></Border>
<UniformGrid Columns="2" Margin="0,16,-14,16"><Border Style="{StaticResource CarePanel}" Margin="0,0,14,0"><StackPanel><ui:SymbolIcon Symbol="Broom24" FontSize="25" Foreground="{DynamicResource CareCleanupAccent}" HorizontalAlignment="Left"/><TextBlock Text="Clean old junk" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Old temporary files and disposable caches from closed browsers. Documents and projects stay protected." Style="{StaticResource CareCaption}" MinHeight="58"/><ui:Button Content="Clean old junk" Style="{StaticResource CareAction}" Command="{Binding ViewModel.CleanSafeJunkCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}" Margin="0,14,0,0" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource CarePanel}" Margin="0,0,14,0"><StackPanel><ui:SymbolIcon Symbol="Storage24" FontSize="25" Foreground="{DynamicResource CareDriveAccent}" HorizontalAlignment="Left"/><TextBlock Text="Optimize your drive" FontSize="18" FontWeight="SemiBold" Margin="0,12,0,8"/><TextBlock Text="Windows chooses the right operation for your drive, including TRIM where supported." Style="{StaticResource CareCaption}" MinHeight="58"/><ui:Button Content="Optimize drive" Command="{Binding ViewModel.OptimizeDiskCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}" Margin="0,14,0,0" HorizontalAlignment="Left"/></StackPanel></Border></UniformGrid>
<Border Style="{StaticResource CarePanel}"><StackPanel><TextBlock Text="ACTIVITY" Style="{StaticResource CareEyebrow}"/><TextBlock Text="{Binding ViewModel.CleanupStatus}" Style="{StaticResource CareCaption}" Margin="0,10,0,7"/><TextBlock Text="{Binding ViewModel.OptimizationStatus}" Style="{StaticResource CareCaption}"/><ProgressBar Height="3" IsIndeterminate="{Binding ViewModel.Cleaning}" Visibility="{Binding ViewModel.Cleaning,Converter={StaticResource BoolToVis}}" Margin="0,10,0,0"/></StackPanel></Border>
<WrapPanel Margin="0,16,0,0"><ui:Button Content="Advanced cleanup" Command="{Binding ViewModel.NavigateToolCommand}" CommandParameter="system" Margin="0,0,10,10"/><ui:Button Content="Disk analyzer" Command="{Binding ViewModel.NavigateToolCommand}" CommandParameter="disk" Margin="0,0,10,10"/><ui:Button Content="Duplicate files" Command="{Binding ViewModel.NavigateToolCommand}" CommandParameter="duplicates" Margin="0,0,10,10"/><ui:Button Content="Windows drive tools" Command="{Binding ViewModel.OpenOptimizationCommand}" Margin="0,0,10,10"/></WrapPanel>
</StackPanel></ScrollViewer></UserControl>