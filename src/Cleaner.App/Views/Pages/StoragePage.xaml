<UserControl x:Class="Cleaner.App.Views.Pages.StoragePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <ScrollViewer Padding="30,24,30,24" VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="Storage" Style="{StaticResource CareSectionTitle}"/><TextBlock Text="Clean disposable files and keep your system drive maintained." Style="{StaticResource PageSubtitle}"/>
  <Border Style="{StaticResource CarePanel}" Margin="0,0,0,20"><DockPanel><StackPanel><TextBlock Text="{Binding ViewModel.DiskAvailable}" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewModel.DiskDetail}" Style="{StaticResource CareCaption}" Margin="0,6,0,0"/></StackPanel><StackPanel HorizontalAlignment="Right" Width="220" VerticalAlignment="Center"><ProgressBar Value="{Binding ViewModel.DiskUsed}" Maximum="100" Height="6"/><ui:Button Content="Refresh drive" Appearance="Transparent" Command="{Binding ViewModel.RefreshStorageCommand}" HorizontalAlignment="Right" Padding="0,5"/></StackPanel></DockPanel></Border>
  <UniformGrid Columns="2" Margin="0,0,-16,20"><Border Style="{StaticResource CarePanel}" Margin="0,0,16,0"><StackPanel><ui:SymbolIcon Symbol="Broom24" FontSize="25" Foreground="{DynamicResource CareAccentBrush}" HorizontalAlignment="Left"/><TextBlock Text="Clean old junk" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,8"/><TextBlock Text="Remove eligible temporary files and closed-browser cache older than seven days. Documents and projects stay protected." Style="{StaticResource CareCaption}" MinHeight="66" Margin="0,0,0,16"/><ui:Button Content="Clean old junk" Style="{StaticResource CareAction}" Command="{Binding ViewModel.CleanSafeJunkCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource CarePanel}" Margin="0,0,16,0"><StackPanel><ui:SymbolIcon Symbol="Storage24" FontSize="25" Foreground="{DynamicResource CareAccentBrush}" HorizontalAlignment="Left"/><TextBlock Text="Drive optimization" FontSize="18" FontWeight="SemiBold" Margin="0,14,0,8"/><TextBlock Text="Let Windows choose the appropriate drive operation, including TRIM where supported. Uses the Microsoft-signed Windows tool." Style="{StaticResource CareCaption}" MinHeight="66" Margin="0,0,0,16"/><ui:Button Content="Optimize system drive" Command="{Binding ViewModel.OptimizeDiskCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}" HorizontalAlignment="Left"/></StackPanel></Border></UniformGrid>
  <Border Style="{StaticResource CarePanel}" Margin="0,0,0,18"><StackPanel><TextBlock Text="Activity" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewModel.CleanupStatus}" Style="{StaticResource CareCaption}" Margin="0,10,0,8"/><TextBlock Text="{Binding ViewModel.OptimizationStatus}" Style="{StaticResource CareCaption}"/><ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding ViewModel.Cleaning,Converter={StaticResource BoolToVis}}" Margin="0,12,0,0"/></StackPanel></Border>
  <WrapPanel><ui:Button Content="Advanced cleanup" Command="{Binding ViewModel.NavigateToolCommand}" CommandParameter="system" Margin="0,0,10,10"/><ui:Button Content="Disk analyzer" Command="{Binding ViewModel.NavigateToolCommand}" CommandParameter="disk" Margin="0,0,10,10"/><ui:Button Content="Duplicate files" Command="{Binding ViewModel.NavigateToolCommand}" CommandParameter="duplicates" Margin="0,0,10,10"/><ui:Button Content="Optimize Drives" Command="{Binding ViewModel.OpenOptimizationCommand}" Margin="0,0,10,10"/></WrapPanel>
 </StackPanel></ScrollViewer>
</UserControl>
