<UserControl x:Class="Cleaner.App.Views.Pages.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="26,20"><StackPanel>
  <Grid Margin="0,0,0,20"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Overview" Style="{StaticResource CareSectionTitle}"/><TextBlock Text="Live performance and recommended maintenance." Style="{StaticResource CareCaption}"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ViewModel.ReadingTime}" Style="{StaticResource CareCaption}" FontSize="11" VerticalAlignment="Center"/></Grid>
  <UniformGrid Columns="3" Margin="0,0,-12,16">
<Border Style="{StaticResource CarePanel}" Margin="0,0,12,0" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="CPU" Style="{StaticResource CareEyebrow}" Foreground="{DynamicResource CareMemoryAccent}"/><TextBlock Text="Processor activity" Style="{StaticResource CareCaption}" FontSize="10" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ViewModel.CpuReading}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border><Border Style="{StaticResource CarePanel}" Margin="0,0,12,0" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="GPU" Style="{StaticResource CareEyebrow}" Foreground="{DynamicResource CareSecurityAccent}"/><TextBlock Text="Busiest graphics engine" Style="{StaticResource CareCaption}" FontSize="10" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ViewModel.GpuReading}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border><Border Style="{StaticResource CarePanel}" Margin="0,0,12,0" Padding="16,12"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="RAM" Style="{StaticResource CareEyebrow}" Foreground="{DynamicResource CareCleanupAccent}"/><TextBlock Text="Physical memory in use" Style="{StaticResource CareCaption}" FontSize="10" Margin="0,6,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ViewModel.RamReading}" FontSize="28" FontWeight="SemiBold" VerticalAlignment="Center"/></Grid></Border></UniformGrid>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
   <Border Style="{StaticResource CarePanel}" Padding="20"><StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SMART CARE" Style="{StaticResource CareEyebrow}"/><TextBlock Text="Recommended maintenance" FontSize="20" FontWeight="SemiBold" Margin="0,7,12,0" TextWrapping="Wrap"/></StackPanel><ui:Button Grid.Column="1" Content="Start care" Icon="{ui:SymbolIcon Flash24}" Style="{StaticResource CareAction}" Command="{Binding ViewModel.StartSmartCareCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}" VerticalAlignment="Center" AutomationProperties.Name="Start recommended Smart Care"/></Grid>
    <TextBlock Text="{Binding ViewModel.StageTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,5"/><TextBlock Text="{Binding ViewModel.StageDetail}" Style="{StaticResource CareCaption}" MaxHeight="40" TextTrimming="CharacterEllipsis"/>
    <ProgressBar Height="3" IsIndeterminate="{Binding ViewModel.SmartCareRunning}" Margin="0,10,0,6" Visibility="{Binding ViewModel.SmartCareRunning,Converter={StaticResource BoolToVis}}"/>
    <ItemsControl ItemsSource="{Binding ViewModel.CareSteps}" Margin="0,12,0,0"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource CareDividerBrush}" BorderThickness="0,0,0,1" Padding="0,9"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Marker}" Foreground="{DynamicResource CareAccentBrush}" FontSize="14"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12"/><TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource CareStepStatus}" HorizontalAlignment="Right"/></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <ui:Button Content="Stop remaining actions" Command="{Binding ViewModel.StopSmartCareCommand}" Visibility="{Binding ViewModel.SmartCareRunning,Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" Margin="0,12,0,0"/>
   </StackPanel></Border>
   <StackPanel Grid.Column="2">
    <Border Style="{StaticResource CarePanel}" Background="{DynamicResource CareAccentSurface}" BorderBrush="{DynamicResource CareMemoryStroke}"><StackPanel><ui:SymbolIcon Symbol="WeatherMoon24" FontSize="24" Foreground="{DynamicResource CareAccentBrush}" HorizontalAlignment="Left"/><TextBlock Text="Focus mode" FontSize="19" FontWeight="SemiBold" Margin="0,12,0,6"/><TextBlock Text="Prioritize your work and reduce interruptions." Style="{StaticResource CareCaption}" Margin="0,0,0,14"/><ui:Button Content="Open Focus mode" Command="{Binding ViewModel.NavigateToolCommand}" CommandParameter="focus" HorizontalAlignment="Stretch"/></StackPanel></Border>
<ui:Button Command="{Binding ViewModel.NavigateToolCommand}" CommandParameter="memory" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Flash24" Foreground="{DynamicResource CareAccentBrush}" FontSize="20"/><StackPanel Grid.Column="1"><TextBlock Text="Memory Boost" FontWeight="SemiBold"/><TextBlock Text="Measured results, protected work" Style="{StaticResource CareCaption}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid></ui:Button><ui:Button Command="{Binding ViewModel.NavigateToolCommand}" CommandParameter="protection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Shield24" Foreground="{DynamicResource CareAccentBrush}" FontSize="20"/><StackPanel Grid.Column="1"><TextBlock Text="Windows protection" FontWeight="SemiBold"/><TextBlock Text="Status, scans and CPU controls" Style="{StaticResource CareCaption}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid></ui:Button><ui:Button Command="{Binding ViewModel.NavigateToolCommand}" CommandParameter="storage" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="14" Margin="0,10,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Storage24" Foreground="{DynamicResource CareAccentBrush}" FontSize="20"/><StackPanel Grid.Column="1"><TextBlock Text="Storage tools" FontWeight="SemiBold"/><TextBlock Text="Clean junk and inspect your drive" Style="{StaticResource CareCaption}" FontSize="10" Margin="0,4,0,0"/></StackPanel></Grid></ui:Button></StackPanel></Grid>
  <Expander x:Name="CareDecisionsExpander" Header="Activity and care decisions" Margin="0,16,0,0"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding ViewModel.SmartCareStatus}" Style="{StaticResource CareCaption}" Margin="0,0,0,10"/><ItemsControl ItemsSource="{Binding ViewModel.Activity}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource CareDividerBrush}" BorderThickness="0,0,0,1" Padding="0,7"><TextBlock Text="{Binding}" Style="{StaticResource CareCaption}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
 </StackPanel></ScrollViewer>
</UserControl>