<UserControl xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}" x:Class="Cleaner.App.Views.Pages.DashboardPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <UserControl.Resources>
  <Style x:Key="HubTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="FontSize" Value="17"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  <Style x:Key="HubBody" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}"><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="17"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="MinHeight" Value="45"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,24"><StackPanel>
  <Border CornerRadius="16" Padding="24" Margin="0,0,0,20" BorderBrush="#416B8C" BorderThickness="1">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#103C49" Offset="0"/><GradientStop Color="#203957" Offset="0.52"/><GradientStop Color="#38234F" Offset="1"/></LinearGradientBrush></Border.Background>
   <StackPanel>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Background="#23605F" CornerRadius="7" Padding="7"><ui:SymbolIcon Symbol="Flash24" Foreground="#87F3D6" FontSize="18"/></Border><TextBlock Text="SMART CARE" FontSize="11" FontWeight="SemiBold" Foreground="#9EF0DA" Margin="10,0,0,0" VerticalAlignment="Center"/><TextBlock Text="  /  AUTOMATIC" FontSize="11" Foreground="#BACEE7" VerticalAlignment="Center"/></StackPanel>
     <ui:Button Grid.Column="1" Content="Monitor settings" Icon="{ui:SymbolIcon Settings24}" Command="{Binding ViewModel.MonitorSettingsCommand}" Appearance="Transparent" Foreground="#E8F3FF" Padding="10,6"/>
    </Grid>
    <Grid Margin="0,17,0,16"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Margin="0,0,22,0"><TextBlock Text="A little care. A smoother PC." FontSize="27" FontWeight="SemiBold" Foreground="#F3F8FF" TextWrapping="Wrap"/><TextBlock Text="Clean old junk, check protection and give active work room to breathe." Foreground="#C2D5EA" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/></StackPanel>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><ui:Button Content="Run Smart Care" Icon="{ui:SymbolIcon Flash24}" Background="#7AE9CE" Foreground="#07382F" BorderBrush="#9BF4DE" FontWeight="SemiBold" Padding="18,12" Command="{Binding ViewModel.StartSmartCareCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}"/>
      <ui:Button Content="Stop after this action" Appearance="Transparent" Foreground="#F5DBB0" Margin="0,8,0,0" Command="{Binding ViewModel.StopSmartCareCommand}" Visibility="{Binding ViewModel.SmartCareRunning,Converter={StaticResource BoolToVis}}"/></StackPanel>
    </Grid>
    <Border Background="#350A1426" CornerRadius="8" Padding="12,10"><StackPanel>
     <TextBlock Text="{Binding ViewModel.SmartCareStatus}" Foreground="#E7F1FF" FontSize="12" TextWrapping="Wrap"/>
     <ProgressBar Height="3" IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding ViewModel.SmartCareRunning,Converter={StaticResource BoolToVis}}"/>
    </StackPanel></Border>
    <TextBlock Text="Local decisions · no setup · personal files and service changes stay under your control" Foreground="#B8D0E4" FontSize="11" Margin="0,12,0,0" TextWrapping="Wrap"/>
   </StackPanel>
  </Border>
  <Expander x:Name="CareDecisionsExpander" Header="Smart Care · steps and decisions" IsExpanded="{Binding ViewModel.SmartCareRunning,Mode=OneWay}" Margin="0,0,0,18">
   <ItemsControl ItemsSource="{Binding ViewModel.CareSteps}" Margin="0,8,0,0"><ItemsControl.ItemTemplate><DataTemplate>
    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,1,0,0" Padding="0,10">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <TextBlock Text="{Binding Status}"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
       <Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Completed"><Setter Property="Foreground" Value="{DynamicResource SafeBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Running"><Setter Property="Foreground" Value="{DynamicResource CareRunningBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Review"><Setter Property="Foreground" Value="{DynamicResource CareAttentionBrush}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Failed"><Setter Property="Foreground" Value="{DynamicResource CareFailureBrush}"/></DataTrigger></Style.Triggers>
      </Style></TextBlock.Style></TextBlock>
      <StackPanel Grid.Column="1"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding Detail}" Style="{StaticResource StatLabel}" FontSize="12" TextWrapping="Wrap" Margin="0,3,0,0"/></StackPanel>
     </Grid>
    </Border>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </Expander>
  <TextBlock Text="Your care tools" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Style="{StaticResource Card}" Margin="0,0,8,16" Background="{DynamicResource CareMemorySurface}" BorderBrush="{DynamicResource CareMemoryStroke}"><StackPanel>
    <ui:SymbolIcon Symbol="Flash24" FontSize="26" Foreground="{DynamicResource CareMemoryAccent}" HorizontalAlignment="Left"/><TextBlock Text="Smart RAM Boost" Style="{StaticResource HubTitle}"/>
    <TextBlock Text="{Binding ViewModel.BoostStatus}" Style="{StaticResource HubBody}"/>
    <WrapPanel><ui:Button Content="Boost RAM" Appearance="Primary" Foreground="{DynamicResource CarePrimaryForeground}" FontWeight="SemiBold" Command="{Binding ViewModel.BoostRamCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}"/><ui:Button Content="Last results" Margin="8,0,0,0" Command="{Binding ViewModel.BoostResultsCommand}"/></WrapPanel>
    <ProgressBar Height="3" Margin="0,10,0,0" IsIndeterminate="True" Visibility="{Binding ViewModel.BoostRunning,Converter={StaticResource BoolToVis}}"/>
   </StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16" Background="{DynamicResource CareSecuritySurface}" BorderBrush="{DynamicResource CareSecurityStroke}"><StackPanel>
    <ui:SymbolIcon Symbol="Shield24" FontSize="26" Foreground="{DynamicResource CareSecurityAccent}" HorizontalAlignment="Left"/><TextBlock Text="Virus check" Style="{StaticResource HubTitle}"/>
    <TextBlock Text="{Binding ViewModel.SecurityStatus}" Style="{StaticResource HubBody}"/>
    <WrapPanel IsEnabled="{Binding ViewModel.CareControlsReady}"><ui:Button Content="Quick scan" Appearance="Primary" Foreground="{DynamicResource CarePrimaryForeground}" FontWeight="SemiBold" Command="{Binding ViewModel.QuickVirusScanCommand}"/><ui:Button Content="Full scan" Margin="8,0,0,0" Command="{Binding ViewModel.FullVirusScanCommand}"/></WrapPanel>
    <WrapPanel Margin="0,8,0,0"><ui:Button Content="Refresh status" Appearance="Transparent" Padding="0,4,12,4" Margin="0,0,8,0" Command="{Binding ViewModel.RefreshProtectionCommand}"/><ui:Button Content="Windows Security" Appearance="Transparent" Padding="0,4" Command="{Binding ViewModel.OpenSecurityCommand}"/></WrapPanel>
   </StackPanel></Border>
   <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,8,16" Background="{DynamicResource CareCleanupSurface}" BorderBrush="{DynamicResource CareCleanupStroke}"><StackPanel>
    <ui:SymbolIcon Symbol="Broom24" FontSize="26" Foreground="{DynamicResource CareCleanupAccent}" HorizontalAlignment="Left"/><TextBlock Text="Safe junk cleanup" Style="{StaticResource HubTitle}"/>
    <TextBlock Text="{Binding ViewModel.CleanupStatus}" Style="{StaticResource HubBody}"/>
    <ui:Button Content="Clean old junk" Appearance="Primary" Foreground="{DynamicResource CarePrimaryForeground}" FontWeight="SemiBold" HorizontalAlignment="Left" Command="{Binding ViewModel.CleanSafeJunkCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}"/>
    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding ViewModel.Cleaning,Converter={StaticResource BoolToVis}}"/>
    <TextBlock Text="Permanently removes eligible junk older than 7 days. Advanced cleanup previews remain available in File tools." Style="{StaticResource StatLabel}" Margin="0,10,0,0"/>
   </StackPanel></Border>
   <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16" Background="{DynamicResource CareDriveSurface}" BorderBrush="{DynamicResource CareDriveStroke}"><StackPanel>
    <ui:SymbolIcon Symbol="Storage24" FontSize="26" Foreground="{DynamicResource CareDriveAccent}" HorizontalAlignment="Left"/><TextBlock Text="Drive optimization" Style="{StaticResource HubTitle}"/>
    <TextBlock Text="{Binding ViewModel.OptimizationStatus}" Style="{StaticResource HubBody}"/>
    <ui:Button Content="Optimize system drive" Appearance="Primary" Foreground="{DynamicResource CarePrimaryForeground}" FontWeight="SemiBold" HorizontalAlignment="Left" Command="{Binding ViewModel.OptimizeDiskCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}"/>
    <ui:Button Content="Open Optimize Drives" Appearance="Transparent" HorizontalAlignment="Left" Padding="0,4" Margin="0,8,0,0" Command="{Binding ViewModel.OpenOptimizationCommand}"/>
   </StackPanel></Border>
   <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="Startup and apps" Style="{StaticResource HubTitle}"/><TextBlock Text="{Binding ViewModel.StartupStatus}" Style="{StaticResource StatLabel}" Margin="0,0,0,14"/>
    <WrapPanel><ui:Button Content="Startup apps" Icon="{ui:SymbolIcon Rocket24}" Command="{Binding ViewModel.ManageStartupCommand}" Margin="0,0,8,8"/><ui:Button Content="Windows services" Icon="{ui:SymbolIcon Settings24}" Command="{Binding ViewModel.ManageServicesCommand}" Margin="0,0,8,8"/><ui:Button Content="Installed apps" Icon="{ui:SymbolIcon Apps24}" Command="{Binding ViewModel.ManageAppsCommand}" Margin="0,0,0,8"/></WrapPanel>
   </StackPanel></Border>
  </Grid>
  <TextBlock Text="Recent activity" Style="{StaticResource HubTitle}" Margin="0,22,0,12"/><TextBlock Text="Operations and startup alerts appear here as they happen." Style="{StaticResource StatLabel}" Margin="0,0,0,10"/>
  <ItemsControl ItemsSource="{Binding ViewModel.Activity}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,9"><TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></ScrollViewer>
</UserControl>
