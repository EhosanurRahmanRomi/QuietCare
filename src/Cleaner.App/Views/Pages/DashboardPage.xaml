<UserControl x:Class="Cleaner.App.Views.Pages.DashboardPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="30,24,30,24"><StackPanel>
  <DockPanel Margin="0,0,0,20"><StackPanel><TextBlock Text="Overview" Style="{StaticResource CareSectionTitle}"/><TextBlock Text="Your PC at a glance" Style="{StaticResource CareCaption}"/></StackPanel><StackPanel HorizontalAlignment="Right" VerticalAlignment="Center"><TextBlock Text="{Binding ViewModel.ReadingTime}" Style="{StaticResource CareCaption}" HorizontalAlignment="Right"/><ui:Button Content="Refresh readings" Appearance="Transparent" Padding="0,4" Command="{Binding ViewModel.RefreshReadingsCommand}" HorizontalAlignment="Right"/></StackPanel></DockPanel>
  <UniformGrid Columns="3" Margin="0,0,-12,18">
   <Border Style="{StaticResource CarePanel}" Margin="0,0,12,0" Padding="18,14"><StackPanel><DockPanel><TextBlock Text="CPU" Style="{StaticResource CareCaption}"/><TextBlock Text="{Binding ViewModel.CpuReading}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel><ProgressBar Value="{Binding ViewModel.CpuValue}" Maximum="100" Height="3" Margin="0,12,0,8"/><TextBlock Text="Processor activity" Style="{StaticResource CareCaption}" FontSize="11"/></StackPanel></Border>
   <Border Style="{StaticResource CarePanel}" Margin="0,0,12,0" Padding="18,14"><StackPanel><DockPanel><TextBlock Text="GPU" Style="{StaticResource CareCaption}"/><TextBlock Text="{Binding ViewModel.GpuReading}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel><ProgressBar Value="{Binding ViewModel.GpuValue}" Maximum="100" Height="3" Margin="0,12,0,8"/><TextBlock Text="Busiest graphics engine" Style="{StaticResource CareCaption}" FontSize="11"/></StackPanel></Border>
   <Border Style="{StaticResource CarePanel}" Margin="0,0,12,0" Padding="18,14"><StackPanel><DockPanel><TextBlock Text="Memory" Style="{StaticResource CareCaption}"/><TextBlock Text="{Binding ViewModel.RamReading}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Right"/></DockPanel><ProgressBar Value="{Binding ViewModel.RamValue}" Maximum="100" Height="3" Margin="0,12,0,8"/><TextBlock Text="Physical RAM in use" Style="{StaticResource CareCaption}" FontSize="11"/></StackPanel></Border>
  </UniformGrid>
  <Border Style="{StaticResource CarePanel}" Padding="24" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel VerticalAlignment="Center" Margin="0,0,26,0"><Grid Width="190" Height="190"><Ellipse Stroke="{DynamicResource CareDividerBrush}" StrokeThickness="9"/><Ellipse Stroke="{DynamicResource CareAccentBrush}" StrokeThickness="3" Margin="10" Opacity=".45"/>
    <ui:Button Command="{Binding ViewModel.StartSmartCareCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}" Width="154" Height="154" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#1769D2" Foreground="White" BorderBrush="#3B88E7" CornerRadius="77" AutomationProperties.Name="Start recommended Smart Care"><StackPanel><ui:SymbolIcon Symbol="Flash24" FontSize="32" HorizontalAlignment="Center" Margin="0,0,0,12"/><TextBlock Text="{Binding ViewModel.CareButtonLabel}" Foreground="White" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/></StackPanel></ui:Button>
   </Grid><TextBlock Text="Automatic care" HorizontalAlignment="Center" FontWeight="SemiBold" Margin="0,16,0,5"/><TextBlock Text="Recommended actions for this PC" Style="{StaticResource CareCaption}" HorizontalAlignment="Center" FontSize="11"/></StackPanel>
   <StackPanel Grid.Column="1"><DockPanel><TextBlock Text="Smart Care" FontSize="21" FontWeight="SemiBold"/><Border Background="{DynamicResource CareAccentSurface}" CornerRadius="4" Padding="8,3" HorizontalAlignment="Right"><TextBlock Text="{Binding ViewModel.CareOutcome}" Foreground="{DynamicResource CareAccentBrush}" FontSize="10" FontWeight="SemiBold"/></Border></DockPanel>
    <TextBlock Text="{Binding ViewModel.StageTitle}" FontSize="13" FontWeight="SemiBold" Margin="0,14,0,4"/><TextBlock Text="{Binding ViewModel.StageDetail}" Style="{StaticResource CareCaption}" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,12,0,4" Visibility="{Binding ViewModel.SmartCareRunning,Converter={StaticResource BoolToVis}}"/>
    <ItemsControl ItemsSource="{Binding ViewModel.CareSteps}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="76"/></Grid.ColumnDefinitions><TextBlock Text="{Binding Marker}" Foreground="{DynamicResource CareAccentBrush}" FontSize="15"/><TextBlock Grid.Column="1" Text="{Binding Title}" FontSize="12"/><TextBlock Grid.Column="2" Text="{Binding Status}" Style="{StaticResource CareStepStatus}" HorizontalAlignment="Right"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
    <ui:Button Content="Stop remaining actions" Command="{Binding ViewModel.StopSmartCareCommand}" Visibility="{Binding ViewModel.SmartCareRunning,Converter={StaticResource BoolToVis}}" HorizontalAlignment="Left" Margin="0,8,0,0"/>
   </StackPanel>
  </Grid></Border>
  <UniformGrid Columns="3" Margin="0,0,-12,20">
   <ui:Button Command="{Binding ViewModel.NavigateToolCommand}" CommandParameter="memory" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15" Margin="0,0,12,0"><StackPanel><TextBlock Text="Memory Boost  ›" FontWeight="SemiBold"/><TextBlock Text="Free eligible idle memory" Style="{StaticResource CareCaption}" Margin="0,5,0,0" FontSize="11"/></StackPanel></ui:Button>
   <ui:Button Command="{Binding ViewModel.NavigateToolCommand}" CommandParameter="protection" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15" Margin="0,0,12,0"><StackPanel><TextBlock Text="Protection  ›" FontWeight="SemiBold"/><TextBlock Text="Windows antivirus and scans" Style="{StaticResource CareCaption}" Margin="0,5,0,0" FontSize="11"/></StackPanel></ui:Button>
   <ui:Button Command="{Binding ViewModel.NavigateToolCommand}" CommandParameter="startup" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="15" Margin="0,0,12,0"><StackPanel><TextBlock Text="Startup  ›" FontWeight="SemiBold"/><TextBlock Text="Apps that start with Windows" Style="{StaticResource CareCaption}" Margin="0,5,0,0" FontSize="11"/></StackPanel></ui:Button>
  </UniformGrid>
  <Expander x:Name="CareDecisionsExpander" Header="Activity and care details"><StackPanel Margin="0,10,0,0"><TextBlock Text="{Binding ViewModel.SmartCareStatus}" Style="{StaticResource CareCaption}" Margin="0,0,0,12"/><ItemsControl ItemsSource="{Binding ViewModel.Activity}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource CareDividerBrush}" BorderThickness="0,0,0,1" Padding="0,9"><TextBlock Text="{Binding}" Style="{StaticResource CareCaption}"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Expander>
 </StackPanel></ScrollViewer>
</UserControl>
