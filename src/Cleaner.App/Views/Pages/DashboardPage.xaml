<UserControl x:Class="Cleaner.App.Views.Pages.DashboardPage"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <UserControl.Resources>
  <Style x:Key="HubTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/><Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,8,0,8"/></Style>
  <Style x:Key="HubBody" TargetType="TextBlock" BasedOn="{StaticResource StatLabel}"><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="18"/><Setter Property="Margin" Value="0,0,0,14"/><Setter Property="MinHeight" Value="54"/></Style>
 </UserControl.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="28,20,28,24"><StackPanel>
  <Border CornerRadius="12" Padding="24" Margin="0,0,0,18" BorderBrush="#32547D" BorderThickness="1">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#203F66" Offset="0"/><GradientStop Color="#20233F" Offset="1"/></LinearGradientBrush></Border.Background>
   <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="PC care, within reach" FontSize="28" FontWeight="SemiBold" Foreground="#F0F6FF"/><TextBlock Text="Clean up. Check protection. Keep startup under control." Foreground="#C0D5EC" Margin="0,7,0,0" TextWrapping="Wrap"/></StackPanel>
    <ui:Button Grid.Column="1" Content="Monitor settings" Icon="{ui:SymbolIcon Settings24}" Command="{Binding ViewModel.MonitorSettingsCommand}" VerticalAlignment="Center" Margin="16,0,0,0"/>
   </Grid>
  </Border>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Border Style="{StaticResource Card}" Margin="0,0,8,16"><StackPanel>
    <ui:SymbolIcon Symbol="Flash24" FontSize="26" Foreground="#67E1B2" HorizontalAlignment="Left"/><TextBlock Text="Smart RAM Boost" Style="{StaticResource HubTitle}"/>
    <TextBlock Text="Trim eligible idle background apps while protecting active work and media. See per-app results; reclaimed resident memory can return when needed." Style="{StaticResource HubBody}"/>
    <WrapPanel><ui:Button Content="Boost RAM" Appearance="Primary" Foreground="#102C43" FontWeight="SemiBold" Command="{Binding ViewModel.BoostRamCommand}"/><ui:Button Content="Last results" Margin="8,0,0,0" Command="{Binding ViewModel.BoostResultsCommand}"/></WrapPanel>
   </StackPanel></Border>
   <Border Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16"><StackPanel>
    <ui:SymbolIcon Symbol="Shield24" FontSize="26" Foreground="#7EC6FF" HorizontalAlignment="Left"/><TextBlock Text="Virus check" Style="{StaticResource HubTitle}"/>
    <TextBlock Text="{Binding ViewModel.SecurityStatus}" Style="{StaticResource HubBody}"/>
    <WrapPanel IsEnabled="{Binding ViewModel.WindowsJobRunning,Converter={StaticResource InverseBool}}"><ui:Button Content="Quick scan" Appearance="Primary" Foreground="#102C43" FontWeight="SemiBold" Command="{Binding ViewModel.QuickVirusScanCommand}"/><ui:Button Content="Full scan" Margin="8,0,0,0" Command="{Binding ViewModel.FullVirusScanCommand}"/></WrapPanel>
    <WrapPanel Margin="0,8,0,0"><ui:Button Content="Refresh status" Appearance="Transparent" Padding="0,4,12,4" Margin="0,0,8,0" Command="{Binding ViewModel.RefreshProtectionCommand}"/><ui:Button Content="Windows Security" Appearance="Transparent" Padding="0,4" Command="{Binding ViewModel.OpenSecurityCommand}"/></WrapPanel>
   </StackPanel></Border>
   <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,8,16"><StackPanel>
    <ui:SymbolIcon Symbol="Broom24" FontSize="26" Foreground="#C3A4FF" HorizontalAlignment="Left"/><TextBlock Text="Safe junk cleanup" Style="{StaticResource HubTitle}"/>
    <TextBlock Text="{Binding ViewModel.CleanupStatus}" Style="{StaticResource HubBody}"/>
    <ui:Button Content="Clean old junk" Appearance="Primary" Foreground="#102C43" FontWeight="SemiBold" HorizontalAlignment="Left" Command="{Binding ViewModel.CleanSafeJunkCommand}" IsEnabled="{Binding ViewModel.Cleaning,Converter={StaticResource InverseBool}}"/>
    <ProgressBar Height="3" IsIndeterminate="True" Margin="0,10,0,0" Visibility="{Binding ViewModel.Cleaning,Converter={StaticResource BoolToVis}}"/>
    <TextBlock Text="Permanently removes eligible junk older than 7 days. Advanced cleanup previews remain available in File tools." Style="{StaticResource StatLabel}" Margin="0,10,0,0"/>
   </StackPanel></Border>
   <Border Grid.Row="1" Grid.Column="1" Style="{StaticResource Card}" Margin="8,0,0,16"><StackPanel>
    <ui:SymbolIcon Symbol="Storage24" FontSize="26" Foreground="#FFC680" HorizontalAlignment="Left"/><TextBlock Text="Drive optimization" Style="{StaticResource HubTitle}"/>
    <TextBlock Text="{Binding ViewModel.OptimizationStatus}" Style="{StaticResource HubBody}"/>
    <ui:Button Content="Optimize system drive" Appearance="Primary" Foreground="#102C43" FontWeight="SemiBold" HorizontalAlignment="Left" Command="{Binding ViewModel.OptimizeDiskCommand}" IsEnabled="{Binding ViewModel.WindowsJobRunning,Converter={StaticResource InverseBool}}"/>
    <ui:Button Content="Open Optimize Drives" Appearance="Transparent" HorizontalAlignment="Left" Padding="0,4" Margin="0,8,0,0" Command="{Binding ViewModel.OpenOptimizationCommand}"/>
   </StackPanel></Border>
   <Border Grid.Row="2" Grid.ColumnSpan="2" Style="{StaticResource Card}"><StackPanel>
    <TextBlock Text="Startup and apps" Style="{StaticResource HubTitle}"/><TextBlock Text="{Binding ViewModel.StartupStatus}" Style="{StaticResource StatLabel}" Margin="0,0,0,14"/>
    <WrapPanel><ui:Button Content="Startup apps" Icon="{ui:SymbolIcon Rocket24}" Command="{Binding ViewModel.ManageStartupCommand}" Margin="0,0,8,8"/><ui:Button Content="Windows services" Icon="{ui:SymbolIcon Settings24}" Command="{Binding ViewModel.ManageServicesCommand}" Margin="0,0,8,8"/><ui:Button Content="Installed apps" Icon="{ui:SymbolIcon Apps24}" Command="{Binding ViewModel.ManageAppsCommand}" Margin="0,0,0,8"/></WrapPanel>
   </StackPanel></Border>
  </Grid>
  <TextBlock Text="Activity" Style="{StaticResource HubTitle}" Margin="0,22,0,12"/><TextBlock Text="Operations and startup alerts appear here as they happen." Style="{StaticResource StatLabel}" Margin="0,0,0,10"/>
  <ItemsControl ItemsSource="{Binding ViewModel.Activity}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" Padding="0,9"><TextBlock Text="{Binding}" FontSize="12" TextWrapping="Wrap"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 </StackPanel></ScrollViewer>
</UserControl>
