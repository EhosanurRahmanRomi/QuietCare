<UserControl xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}" x:Class="Cleaner.App.Views.Pages.AutostartPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:vm="clr-namespace:Cleaner.App.ViewModels.Pages"
      xmlns:l="clr-namespace:Cleaner.App.Localization"
      xmlns:controls="clr-namespace:Cleaner.App.Controls"
      xmlns:core="clr-namespace:Cleaner.Core.Services;assembly=Cleaner.Core"
      mc:Ignorable="d"
      d:DataContext="{d:DesignInstance Type=vm:AutostartViewModel}">
    <Grid Margin="30,24,30,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{l:T Autostart.Title}" Style="{StaticResource PageTitle}" />
            <TextBlock Text="Review what starts with Windows. Changes to current-user items are backed up; system items are managed with Windows tools."
                       Style="{StaticResource PageSubtitle}" />
        </StackPanel>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,16">
            <WrapPanel>
                <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Search24}"
                           Content="Refresh startup entries" Command="{Binding ViewModel.ScanCommand}" Margin="0,0,0,8"/>
<ui:Button Content="Windows Startup settings" Command="{Binding ViewModel.OpenWindowsStartupCommand}" Margin="8,0,0,8"/>
<ui:Button Content="Task Scheduler" Command="{Binding ViewModel.OpenTaskSchedulerCommand}" Margin="8,0,0,8"/>
            </WrapPanel>
        </Border>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="0">
            <controls:PowerGrid GridId="autostart" ItemsSource="{Binding ViewModel.Entries}">
                <controls:PowerGrid.RowContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{l:T Reveal}"
                                  Command="{Binding Tag.ViewModel.ShowLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Folder24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:T Autostart.OpenFile}"
                                  Command="{Binding Tag.ViewModel.RunCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Open24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:T WindowsProperties}"
                                  Command="{Binding Tag.ViewModel.OpenPropertiesCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Info24" /></MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="{l:T SearchWeb}"
                                  Command="{Binding Tag.ViewModel.SearchWebCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Search24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="{l:T CopyCommand}"
                                  Command="{Binding Tag.ViewModel.CopyCommandCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="Copy24" /></MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Enable / disable" IsEnabled="{Binding CanToggle}"
                                  Command="{Binding Tag.ViewModel.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding}">
                            <MenuItem.Icon><ui:SymbolIcon Symbol="ToggleLeft24" /></MenuItem.Icon>
                        </MenuItem>

                    </ContextMenu>
                </controls:PowerGrid.RowContextMenu>

                <DataGridTemplateColumn Header="{l:T Col.Active}" Width="70" SortMemberPath="IsEnabled">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type core:AutostartEntry}">
                            <CheckBox IsChecked="{Binding IsEnabled, Mode=OneWay}" HorizontalAlignment="Center"
                                      Command="{Binding DataContext.ViewModel.ToggleEnabledCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                      CommandParameter="{Binding}"
                                      IsEnabled="{Binding CanToggle}" ToolTip="{Binding ManagementHint}" />
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="{l:T Col.Name}" Binding="{Binding Name}" Width="*" />
                <DataGridTextColumn Header="Publisher" Binding="{Binding Publisher}" Width="130" />
                <DataGridTextColumn Header="Command" Binding="{Binding Command}" Width="2*" />
                <DataGridTextColumn Header="{l:T Col.Source}" Binding="{Binding SourceLabel}" Width="140" />
                <DataGridTemplateColumn Header="" Width="110" CanUserReorder="False">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate DataType="{x:Type core:AutostartEntry}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Appearance="Secondary" Padding="6,2" FontSize="11"
                                           Icon="{ui:SymbolIcon Folder24}" Content="{l:T Autostart.ShowShort}"
                                           Command="{Binding DataContext.ViewModel.ShowLocationCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                           CommandParameter="{Binding}" />

                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </controls:PowerGrid>
        </Border>

        <StackPanel Grid.Row="3" Margin="0,16,0,0">
            <TextBlock Text="{Binding ViewModel.StatusText}" Opacity="0.8" />
            <ProgressBar Height="4" Margin="0,8,0,0" IsIndeterminate="{Binding ViewModel.IsLoading}"
                         Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BoolToVis}}" />
        </StackPanel>
    </Grid>
</UserControl>
