<UserControl xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}" x:Class="Cleaner.App.Views.Pages.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
 <ScrollViewer Padding="30,24,30,24" VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="About QuietCare" Style="{StaticResource CareSectionTitle}"/><TextBlock Text="Windows care with clear actions and measured results." Style="{StaticResource PageSubtitle}"/>
  <Border Style="{StaticResource CarePanel}" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Image Source="pack://application:,,,/Assets/QuietCare.png" Width="64" Height="64" HorizontalAlignment="Left" VerticalAlignment="Top"/><StackPanel Grid.Column="1"><TextBlock Text="QuietCare" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewModel.Version}" Style="{StaticResource CareCaption}" Margin="0,6,0,12"/><TextBlock Text="Smart Care, Memory Boost, Windows protection, storage tools and startup management, with a tiny transparent performance monitor." Style="{StaticResource CareCaption}"/></StackPanel></Grid></Border>
  <Border Style="{StaticResource CarePanel}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Updates" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Check the official GitHub releases. Updates are downloaded and installed by you." Style="{StaticResource CareCaption}" Margin="0,8,0,16"/><WrapPanel><ui:Button Content="Check for updates" Style="{StaticResource CareAction}" Command="{Binding ViewModel.Updates.CheckCommand}" Margin="0,0,12,8"/><ui:Button Content="Open release notes" Command="{Binding ViewModel.Updates.OpenReleasesCommand}" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="{Binding ViewModel.Updates.Status}" Style="{StaticResource CareCaption}" Margin="0,10,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource CarePanel}"><StackPanel><TextBlock Text="Open source and local care" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewModel.Attribution}" Style="{StaticResource CareCaption}" Margin="0,10,0,12"/><TextBlock Text="Licenses and source notices are installed beside the application. Care decisions run locally. Defender supplies malware scanning; Windows supplies drive optimization. RAM Boost reports the measured change and preserves app allocations." Style="{StaticResource CareCaption}"/><TextBlock Text="Preview release. Settings and Recovery are kept when you uninstall. Share issues through the project repository." Style="{StaticResource CareCaption}" Margin="0,12,0,0"/></StackPanel></Border>
 </StackPanel></ScrollViewer>
</UserControl>
