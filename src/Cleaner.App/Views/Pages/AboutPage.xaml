<UserControl xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}" x:Class="Cleaner.App.Views.Pages.AboutPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<StackPanel Margin="32" MaxWidth="760" HorizontalAlignment="Left">
<TextBlock Text="QuietCare Next" FontSize="32" FontWeight="SemiBold" />
<TextBlock Text="{Binding ViewModel.Version}" Margin="0,8,0,24" />
<TextBlock Text="{Binding ViewModel.Attribution}" TextWrapping="Wrap" FontSize="15" />
<TextBlock Margin="0,24,0,0" TextWrapping="Wrap" Text="Preview build. Review scan results before cleaning. No automatic downloads, global kill shortcuts, embedded web pages, or automatic cleaning. This preview uses separate settings and does not replace QuietCare 0.3." />
<TextBlock Margin="0,16,0,0" TextWrapping="Wrap" Text="License and source provenance are included in THIRD-PARTY-NOTICES.md. The full upstream MIT license is preserved. No security or performance guarantee is implied." />
<TextBlock Text="Updates" FontSize="20" FontWeight="SemiBold" Margin="0,28,0,12" />
<StackPanel Orientation="Horizontal"><Button Content="Check for updates" Command="{Binding ViewModel.Updates.CheckCommand}" Padding="14,8" Margin="0,0,10,0"/><Button Content="Open release notes" Command="{Binding ViewModel.Updates.OpenReleasesCommand}" Padding="14,8"/></StackPanel>
<TextBlock Text="{Binding ViewModel.Updates.Status}" TextWrapping="Wrap" Margin="0,12,0,0" />
</StackPanel></UserControl>
