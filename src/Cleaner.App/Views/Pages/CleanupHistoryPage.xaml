<UserControl x:Class="Cleaner.App.Views.Pages.CleanupHistoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid Margin="32"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
<StackPanel><TextBlock Text="Recovery" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Review, restore or permanently delete quarantined files." Margin="0,8,0,20"/></StackPanel>
<StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16"><Button Content="Refresh" Command="{Binding ViewModel.RefreshCommand}" Padding="14,8" Margin="0,0,8,0"/><Button Content="Restore selected" Command="{Binding ViewModel.RestoreCommand}" Padding="14,8" Margin="0,0,8,0"/><Button Content="Permanently delete selected…" Command="{Binding ViewModel.PurgeCommand}" Padding="14,8"/></StackPanel>
<DataGrid Grid.Row="2" ItemsSource="{Binding ViewModel.Files}" SelectedItem="{Binding ViewModel.Selected}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" SelectionMode="Single" EnableRowVirtualization="True"><DataGrid.Columns><DataGridTextColumn Header="Original path" Binding="{Binding Original}" Width="*"/><DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="100"/><DataGridTextColumn Header="Quarantined" Binding="{Binding When}" Width="160"/></DataGrid.Columns></DataGrid>
<TextBlock Grid.Row="3" Text="{Binding ViewModel.Status}" TextWrapping="Wrap" Margin="0,16,0,0"/>
</Grid></UserControl>