<UserControl x:Class="Cleaner.App.Views.Pages.ProtectionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <ScrollViewer Padding="30,24,30,24" VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="Protection" Style="{StaticResource CareSectionTitle}"/><TextBlock Text="Check your Windows antivirus and run a real Microsoft Defender scan." Style="{StaticResource PageSubtitle}"/>
  <Border Style="{StaticResource CarePanel}" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="68"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="{DynamicResource CareAccentSurface}" CornerRadius="12" Width="50" Height="56" HorizontalAlignment="Left"><ui:SymbolIcon Symbol="Shield24" Foreground="{DynamicResource CareAccentBrush}" FontSize="30"/></Border><StackPanel Grid.Column="1"><TextBlock Text="{Binding ViewModel.ProtectionBadge}" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewModel.ProtectionDetail}" Style="{StaticResource CareCaption}" Margin="0,8,20,0"/></StackPanel><ui:Button Grid.Column="2" Content="Refresh status" Command="{Binding ViewModel.RefreshProtectionCommand}" VerticalAlignment="Center"/></Grid></Border>
  <Border Style="{StaticResource CarePanel}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Advanced real-time control" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewModel.RealtimePolicyInfo}" Style="{StaticResource CareCaption}" Margin="0,10,0,12"/><TextBlock Text="Keep automatic real-time file scanning off through this PC's local Windows policy, with a saved backup of that setting. Files you open or download will not receive real-time antivirus scanning. This applies to the PC and requires administrator approval." Style="{StaticResource CareCaption}" Margin="0,0,0,12"/><TextBlock Text="Available on Windows Pro, Enterprise and Education when Tamper Protection is off and the PC is unmanaged. QuietCare does not bypass Windows protection. Updates or policy can override the request; use Refresh status to check the actual result. Manual scans and Defender updates remain available." Style="{StaticResource CareCaption}" Margin="0,0,0,16"/><WrapPanel IsEnabled="{Binding ViewModel.CareControlsReady}"><ui:Button Content="Keep real-time scanning off" Command="{Binding ViewModel.KeepRealtimeOffCommand}" IsEnabled="{Binding ViewModel.CanKeepRealtimeOff}" Margin="0,0,10,8"/><ui:Button Content="Restore protection" Command="{Binding ViewModel.RestoreRealtimeCommand}" IsEnabled="{Binding ViewModel.CanChangeDefender}" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="{Binding ViewModel.DefenderControlStatus}" Style="{StaticResource CareCaption}" Margin="0,10,0,0"/></StackPanel></Border>
  <UniformGrid Columns="2" Margin="0,0,-16,20"><Border Style="{StaticResource CarePanel}" Margin="0,0,16,0"><StackPanel><TextBlock Text="Quick scan" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Check common threat locations with the installed Microsoft scanner." Style="{StaticResource CareCaption}" Margin="0,10,0,18" MinHeight="48"/><ui:Button Content="Start quick scan" Style="{StaticResource CareAction}" Command="{Binding ViewModel.QuickVirusScanCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}" HorizontalAlignment="Left"/></StackPanel></Border><Border Style="{StaticResource CarePanel}" Margin="0,0,16,0"><StackPanel><TextBlock Text="Full scan" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="A broader Defender scan. It can take longer and use more system resources." Style="{StaticResource CareCaption}" Margin="0,10,0,18" MinHeight="48"/><ui:Button Content="Start full scan" Command="{Binding ViewModel.FullVirusScanCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}" HorizontalAlignment="Left"/></StackPanel></Border></UniformGrid>
  <Border Style="{StaticResource CarePanel}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Reduce scan CPU use" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewModel.ScanCpuSettings}" Style="{StaticResource CareCaption}" Margin="0,10,0,10"/><TextBlock Text="Use a 20% average scan target, lower scheduled-scan priority and throttling during idle scans. Scans can take longer. This is not a hard CPU cap and does not limit real-time scans." Style="{StaticResource CareCaption}" Margin="0,0,0,16"/><WrapPanel IsEnabled="{Binding ViewModel.CareControlsReady}"><ui:Button Content="Lower scan CPU" Command="{Binding ViewModel.LowerScanCpuCommand}" IsEnabled="{Binding ViewModel.CanChangeDefender}" Margin="0,0,10,8"/><ui:Button Content="Restore scan settings" Command="{Binding ViewModel.RestoreScanCpuCommand}" IsEnabled="{Binding ViewModel.HasScanCpuBackup}" Margin="0,0,0,8"/></WrapPanel></StackPanel></Border>
  <Border Style="{StaticResource CarePanel}"><StackPanel><TextBlock Text="Scan status" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewModel.SecurityStatus}" Style="{StaticResource CareCaption}" Margin="0,10,0,16"/><ui:Button Content="Open Windows Security" Icon="{ui:SymbolIcon Open24}" Command="{Binding ViewModel.OpenSecurityCommand}" HorizontalAlignment="Left"/></StackPanel></Border><TextBlock Text="Windows may request administrator approval. Review Protection history for exact findings. QuietCare uses your installed Defender engine; it is not a separate antivirus." Style="{StaticResource CareCaption}" Margin="0,18,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>
