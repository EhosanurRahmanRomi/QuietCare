<UserControl x:Class="Cleaner.App.Views.Pages.ProtectionPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}"><ScrollViewer Padding="26,20" VerticalScrollBarVisibility="Auto"><StackPanel>
<Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Protection" Style="{StaticResource CareSectionTitle}"/><TextBlock Text="Windows protection, clearly explained." Style="{StaticResource CareCaption}"/></StackPanel><ui:Button Grid.Column="1" Content="Refresh status" Command="{Binding ViewModel.RefreshProtectionCommand}" VerticalAlignment="Center"/></Grid>
<Border Style="{StaticResource CarePanel}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="50"/><ColumnDefinition/></Grid.ColumnDefinitions><ui:SymbolIcon Symbol="Shield24" FontSize="30" Foreground="{DynamicResource CareSecurityAccent}" HorizontalAlignment="Left"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding ViewModel.ProtectionBadge}" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewModel.ProtectionDetail}" Style="{StaticResource CareCaption}" Margin="0,7,0,0"/></StackPanel></Grid></Border>
<Border Style="{StaticResource CarePanel}" Margin="0,14,0,0"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,18,0"><TextBlock Text="Scan with Microsoft Defender" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Quick checks common locations. Full checks more of the PC." Style="{StaticResource CareCaption}" FontSize="11" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal"><ui:Button Content="Quick scan" Command="{Binding ViewModel.QuickVirusScanCommand}" Style="{StaticResource CareAction}" IsEnabled="{Binding ViewModel.CareControlsReady}" Margin="0,0,8,0"/><ui:Button Content="Full scan" Command="{Binding ViewModel.FullVirusScanCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}"/></StackPanel></Grid><TextBlock Text="{Binding ViewModel.SecurityStatus}" Style="{StaticResource CareCaption}" Margin="0,14,0,0"/></StackPanel></Border>
<Border Style="{StaticResource CarePanel}" Margin="0,14,0,0"><StackPanel><TextBlock Text="A lighter scan workload" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewModel.ScanCpuSettings}" Style="{StaticResource CareCaption}" Margin="0,8,0,6"/><TextBlock Text="20% average scan target and lower scheduled-scan priority. Scans can take longer; real-time scanning is not capped." Style="{StaticResource CareCaption}" FontSize="11"/><WrapPanel Margin="0,14,0,0" IsEnabled="{Binding ViewModel.CareControlsReady}"><ui:Button Content="Lower scan CPU" Command="{Binding ViewModel.LowerScanCpuCommand}" IsEnabled="{Binding ViewModel.CanChangeDefender}" Margin="0,0,8,0"/><ui:Button Content="Restore scan settings" Command="{Binding ViewModel.RestoreScanCpuCommand}" IsEnabled="{Binding ViewModel.HasScanCpuBackup}"/></WrapPanel></StackPanel></Border>
<Expander Header="Advanced real-time protection control" Margin="0,14,0,0"><StackPanel Margin="0,12,0,0"><TextBlock Text="{Binding ViewModel.RealtimePolicyInfo}" Style="{StaticResource CareCaption}"/><TextBlock Text="Keeping real-time scanning off means files you open or download are not scanned in real time. This PC-wide local policy requires Windows approval and a separate confirmation. Available on unmanaged Pro, Enterprise or Education with Tamper Protection already off. Windows updates or policy can override the request." Style="{StaticResource CareCaption}" Margin="0,10,0,12"/><WrapPanel IsEnabled="{Binding ViewModel.CareControlsReady}"><ui:Button Content="Keep real-time scanning off" Command="{Binding ViewModel.KeepRealtimeOffCommand}" IsEnabled="{Binding ViewModel.CanKeepRealtimeOff}" Margin="0,0,8,8"/><ui:Button Content="Restore protection" Command="{Binding ViewModel.RestoreRealtimeCommand}" IsEnabled="{Binding ViewModel.CanChangeDefender}" Margin="0,0,0,8"/></WrapPanel><TextBlock Text="{Binding ViewModel.DefenderControlStatus}" Style="{StaticResource CareCaption}"/></StackPanel></Expander>
<ui:Button Content="Open Windows Security" Command="{Binding ViewModel.OpenSecurityCommand}" Appearance="Transparent" HorizontalAlignment="Left" Padding="0,8" Margin="0,10,0,0"/>
</StackPanel></ScrollViewer></UserControl>