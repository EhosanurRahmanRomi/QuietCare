<UserControl x:Class="Cleaner.App.Views.Pages.MemoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}">
 <ScrollViewer Padding="30,24,30,24" VerticalScrollBarVisibility="Auto"><StackPanel>
  <TextBlock Text="Memory" Style="{StaticResource CareSectionTitle}"/><TextBlock Text="Monitor physical RAM and reclaim eligible idle pages." Style="{StaticResource PageSubtitle}"/>
  <Border Style="{StaticResource CarePanel}" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="200"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel Margin="0,4,30,0"><TextBlock Text="{Binding ViewModel.RamReading}" FontSize="52" FontWeight="Light"/><TextBlock Text="Physical memory in use" Style="{StaticResource CareCaption}" Margin="0,4,0,12"/><ProgressBar Value="{Binding ViewModel.RamValue}" Height="5" Maximum="100"/><TextBlock Text="{Binding ViewModel.AvailableRam}" Style="{StaticResource CareCaption}" Margin="0,12,0,0"/></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="Smart RAM Boost" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Checks inactive apps while preserving foreground work, browser tabs, media and project tools." Style="{StaticResource CareCaption}" Margin="0,10,0,18"/><WrapPanel><ui:Button Content="Boost RAM" Icon="{ui:SymbolIcon Flash24}" Style="{StaticResource CareAction}" Command="{Binding ViewModel.BoostRamCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}"/><ui:Button Content="Last results" Command="{Binding ViewModel.BoostResultsCommand}" Margin="10,0,0,0"/></WrapPanel><ProgressBar Height="3" IsIndeterminate="True" Margin="0,16,0,0" Visibility="{Binding ViewModel.BoostRunning,Converter={StaticResource BoolToVis}}"/></StackPanel>
  </Grid></Border>
  <Border Style="{StaticResource CarePanel}" Margin="0,0,0,20"><StackPanel><TextBlock Text="Boost activity" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="{Binding ViewModel.BoostStatus}" Style="{StaticResource CareCaption}" Margin="0,10,0,0"/></StackPanel></Border>
  <Border Style="{StaticResource CarePanel}"><StackPanel><TextBlock Text="Performance monitor" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Keep the tiny CPU / GPU / RAM monitor above your work. Adjust speed, transparency and startup." Style="{StaticResource CareCaption}" Margin="0,8,0,16"/><ui:Button Content="Monitor and startup settings" Command="{Binding ViewModel.MonitorSettingsCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
  <TextBlock Text="RAM Boost trims resident pages; it does not release app allocations. Windows may reload pages when an app needs them. Results show the actual change after three seconds." Style="{StaticResource CareCaption}" Margin="0,18,0,0"/>
 </StackPanel></ScrollViewer>
</UserControl>
