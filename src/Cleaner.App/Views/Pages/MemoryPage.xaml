<UserControl x:Class="Cleaner.App.Views.Pages.MemoryPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml" xmlns:motion="clr-namespace:Cleaner.App" motion:CareMotion.EnterOnLoad="True" Foreground="{DynamicResource TextFillColorPrimaryBrush}"><ScrollViewer Padding="26,20" VerticalScrollBarVisibility="Auto"><StackPanel>
<TextBlock Text="Memory" Style="{StaticResource CareSectionTitle}"/><TextBlock Text="Boost idle memory without closing your apps." Style="{StaticResource PageSubtitle}"/>
<Border Style="{StaticResource CarePanel}" Padding="22"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,28,0"><TextBlock Text="PHYSICAL RAM" Style="{StaticResource CareEyebrow}"/><TextBlock Text="{Binding ViewModel.RamReading}" FontSize="44" FontWeight="SemiBold" Margin="0,6,0,3"/><TextBlock Text="in use" Style="{StaticResource CareCaption}"/><ProgressBar Value="{Binding ViewModel.RamValue}" Maximum="100" Height="5" Margin="0,16,0,10"/><TextBlock Text="{Binding ViewModel.AvailableRam}" Style="{StaticResource CareCaption}"/></StackPanel><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="Smart RAM Boost" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Checks eligible inactive apps, then measures the actual result." Style="{StaticResource CareCaption}" Margin="0,8,0,16"/><ui:Button Content="Boost RAM" Icon="{ui:SymbolIcon Flash24}" Style="{StaticResource CareAction}" Command="{Binding ViewModel.BoostRamCommand}" IsEnabled="{Binding ViewModel.CareControlsReady}" HorizontalAlignment="Stretch"/><ui:Button Content="View last results" Command="{Binding ViewModel.BoostResultsCommand}" Appearance="Transparent" Margin="0,8,0,0"/><ProgressBar Height="3" IsIndeterminate="{Binding ViewModel.BoostRunning}" Visibility="{Binding ViewModel.BoostRunning,Converter={StaticResource BoolToVis}}" Margin="0,8,0,0"/></StackPanel></Grid></Border>
<Border Style="{StaticResource CarePanel}" Margin="0,16,0,0"><StackPanel><TextBlock Text="LAST ACTIVITY" Style="{StaticResource CareEyebrow}"/><TextBlock Text="{Binding ViewModel.BoostStatus}" Style="{StaticResource CareCaption}" Margin="0,10,0,0"/></StackPanel></Border>
<UniformGrid Columns="3" Margin="0,18,-12,0"><Border BorderBrush="{DynamicResource CareDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0"><StackPanel><ui:SymbolIcon Symbol="Shield24" Foreground="{DynamicResource CareMemoryAccent}" HorizontalAlignment="Left" FontSize="21"/><TextBlock Text="Your work stays open" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock Text="No closed apps or discarded tabs." Style="{StaticResource CareCaption}" FontSize="11"/></StackPanel></Border><Border BorderBrush="{DynamicResource CareDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0"><StackPanel><ui:SymbolIcon Symbol="DataUsage24" Foreground="{DynamicResource CareSecurityAccent}" HorizontalAlignment="Left" FontSize="21"/><TextBlock Text="Measured honestly" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock Text="Reports available RAM after settling." Style="{StaticResource CareCaption}" FontSize="11"/></StackPanel></Border><Border BorderBrush="{DynamicResource CareDividerBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,12,0"><StackPanel><ui:SymbolIcon Symbol="Flash24" Foreground="{DynamicResource CareCleanupAccent}" HorizontalAlignment="Left" FontSize="21"/><TextBlock Text="One click from the mini" FontWeight="SemiBold" Margin="0,10,0,6"/><TextBlock Text="Use its lightning button anytime." Style="{StaticResource CareCaption}" FontSize="11"/></StackPanel></Border></UniformGrid>
<TextBlock Text="Boost trims eligible resident memory. Apps can reuse it, and additional free RAM is not guaranteed. Your document data and application allocations are preserved." Style="{StaticResource CareCaption}" FontSize="11" Margin="0,18,0,0"/>
</StackPanel></ScrollViewer></UserControl>